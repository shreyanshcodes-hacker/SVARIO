# ==============================================================================
# SVARIO API — BACKEND ENVIRONMENT VARIABLES (STAGE 3 TEMPLATE)
# Copy this file to apps/api/.env for local development.
# NEVER commit real secrets, OpenAI keys, or service-role keys to Git.
# ==============================================================================

SVARIO_ENV=development
SVARIO_STAGE=3
API_SERVICE_NAME=Svario API
API_VERSION=0.3.0
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Supabase JWT Verification & Persistence ---
# Prefer asymmetric verification via SUPABASE_JWKS_URL (ES256/RS256/EdDSA).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256,EdDSA

# Optional fallback for projects using symmetric HS256 JWTs (leave empty if using JWKS):
SUPABASE_JWT_SECRET=

# Optional backend-only elevated credentials (never expose to frontend; all queries still enforce explicit membership checks):
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Stage 3: OpenAI Realtime Voice Infrastructure (Backend-Only) ---
# Permanent OpenAI API key MUST remain backend-only and is never returned to browser clients.
OPENAI_API_KEY=your-openai-api-key-placeholder
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_API_BASE_URL=https://api.openai.com/v1
OPENAI_REALTIME_SESSION_TTL_SECONDS=120
OPENAI_REALTIME_MODALITIES=audio,text
VOICE_SESSION_RATE_LIMIT_PER_MINUTE=10
VOICE_PUBLIC_TOKEN_SECRET=your-voice-public-token-secret-placeholder
VOICE_PUBLIC_TOKEN_TTL_SECONDS=3600
