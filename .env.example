# ==============================================================================
# SVARIO — STAGE 1 ENVIRONMENT CONFIGURATION (ROOT TEMPLATE)
# Copy into apps/api/.env and apps/web/.env.local as needed.
# NEVER commit real secrets, API keys, or service-role tokens to Git.
# ==============================================================================

# --- Platform Metadata ---
SVARIO_ENV=development
SVARIO_STAGE=1

# --- Backend API (apps/api) ---
API_SERVICE_NAME="Svario API"
API_VERSION="0.2.0"
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Supabase Backend Configuration (apps/api) ---
# Inspect your Supabase project's JWT settings in Dashboard -> Project Settings -> API.
# Modern Supabase projects support asymmetric JWT signing (ES256/RS256/EdDSA) verified via JWKS.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256,EdDSA

# Optional legacy HS256 secret (ONLY set if your Supabase project still uses symmetric HS256 signing
# AND you explicitly include HS256 in SUPABASE_JWT_ALGORITHMS):
SUPABASE_JWT_SECRET=

# Optional backend-only credentials (NEVER expose to frontend):
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Frontend Web (apps/web) ---
NEXT_PUBLIC_APP_NAME=SVARIO
NEXT_PUBLIC_APP_STAGE=1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# --- Planned Future Integrations (Stage 2+ Placeholders Only) ---
# OPENAI_API_KEY=your-openai-api-key-placeholder
# OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
